import requests
from time import sleep
import numpy as np
import re

s = requests.Session()
s.headers.update({'X-API-key': 'Rotman1'})

MAX_LONG_EXPOSURE_NET = 50000
MAX_SHORT_EXPOSURE_NET = -50000
MAX_EXPOSURE_GROSS = 100000
ORDER_LIMIT = 5000

def get_tick():
    resp = s.get('http://localhost:9999/v1/case')
    if resp.ok:
        case = resp.json()
        return case['tick'], case['status']

def get_news(eps_estimates, ownership_estimates, eps):
    resp = s.get('http://localhost:9999/v1/news', params={'limit': 50})
    if resp.ok:
        news_query = resp.json()
        for i in news_query[::-1]:
            # Regex is much safer than hardcoded offsets like +32 or +5
            # This finds any number after a colon and optional dollar sign
            def extract_val(pattern, text):
                match = re.search(pattern, text)
                return float(match.group(1)) if match else None

            for idx, ticker in enumerate(['TP', 'AS', 'BA']):
                if ticker in i['headline']:
                    # Parse Estimates
                    if "Analyst" in i['headline']:
                        for q in range(1, 5):
                            val = extract_val(rf"Q{q}:\s*\$?([\d.]+)", i['body'])
                            if val is not None: eps_estimates[idx, q-1] = val
                    
                    # Parse Institutional Ownership
                    if "institutional" in i['headline']:
                        val = extract_val(r"([\d.]+)%", i['body'])
                        for q in range(1, 5):
                            if f"Q{q}" in i['headline'] and val is not None:
                                ownership_estimates[idx, q-1] = val

            # Parse Actual Earnings Releases
            if "Earnings release" in i['headline']:
                for idx, ticker in enumerate(['TP', 'AS', 'BA']):
                    for q in range(1, 5):
                        if f"Q{q}" in i['headline']:
                            val = extract_val(rf"{ticker} Q{q}:.*?\$?([\d.]+)", i['body'])
                            if val is not None: eps[idx, q-1] = val
                                
        return eps_estimates, ownership_estimates, eps           

def get_bid_ask(ticker):
    resp = s.get('http://localhost:9999/v1/securities/book', params={'ticker': ticker})
    if resp.ok:
        book = resp.json()
        bid = book['bids'][0]['price'] if book['bids'] else -1
        ask = book['asks'][0]['price'] if book['asks'] else -1
        return bid, ask
    return -1, -1

def get_position():
    resp = s.get('http://localhost:9999/v1/securities')
    if resp.ok:
        book = resp.json()
        # IMPROVEMENT: Use ticker mapping instead of index [0],[1],[2]
        pos_map = {item['ticker']: item['position'] for item in book}
        tp, as_st, ba = pos_map.get('TP', 0), pos_map.get('AS', 0), pos_map.get('BA', 0)
        
        gross = abs(tp) + abs(as_st) + abs(ba)
        net = tp + as_st + ba
        return gross, net, pos_map
    return 0, 0, {}

def cancel_all_orders():
    # CRITICAL: Prevents stale orders from blowing your position limits
    resp = s.get('http://localhost:9999/v1/orders', params={'status': 'OPEN'})
    if resp.ok:
        for order in resp.json():
            s.delete(f"http://localhost:9999/v1/orders/{order['order_id']}")

def compute_DDM(div, g, r):
    # CRITICAL: Prevent division by zero if growth >= cost of equity
    if g >= r - 0.001: g = r - 0.01 
    
    # Stage 1 (Years 1-5)
    # Case brief: Year 1 Dividend is current year's dividend
    pv_stage1 = (div / (r - g)) * (1 - ((1 + g) / (1 + r))**5)
    
    # Stage 2 (Terminal)
    # Case brief: Year 6 = D1 grown for 5 years at g, then once at terminal rate
    d6 = div * ((1 + g)**5) * (1 + 0.02)
    pv_terminal = (d6 / (r - 0.02)) / ((1 + r)**5)
    
    return pv_stage1 + pv_terminal

def compute_TP_val(eps_total, own):
    g = (eps_total / 1.43) - 1
    div = eps_total * 0.80
    ddm = compute_DDM(div, g, 0.05)
    pe_val = eps_total * 12
    # Removed the DDM = max(DDM, pe) floor as it misprices per the case brief
    return (own / 100) * ddm + (1 - own / 100) * pe_val, ddm, pe_val

def compute_AS_val(eps_total, own):
    g = (eps_total / 1.55) - 1
    div = eps_total * 0.50
    ddm = compute_DDM(div, g, 0.075)
    pe_val = eps_total * 16
    return (own / 100) * ddm + (1 - own / 100) * pe_val, ddm, pe_val

def compute_BA_val(eps_total, own):
    g = (eps_total / 1.50) - 1
    pe_inst = 20 * (1 + g) * eps_total
    pe_retail = eps_total * 20
    return (own / 100) * pe_inst + (1 - own / 100) * pe_retail, pe_inst, pe_retail

def main():
    eps_estimates = np.zeros((3, 4))
    ownership_estimates = np.zeros((3, 4))
    eps = np.zeros((3, 4))
    
    # Initial Baseline from prior year (Case Brief)
    eps_val = np.array([[0.40, 0.33, 0.33, 0.37],
                        [0.35, 0.45, 0.50, 0.25],
                        [0.15, 0.50, 0.60, 0.25]])
    own_val = np.array([50.0, 50.0, 50.0]) # Starting mean ownership

    tick, status = get_tick()
    
    while status == "ACTIVE":
        cancel_all_orders()
        gross_position, net_position, pos_map = get_position()
        eps_estimates, ownership_estimates, eps = get_news(eps_estimates, ownership_estimates, eps)

        # Update EPS and Ownership with latest available info
        for i in range(3):
            for j in range(4):
                if eps[i, j] != 0: eps_val[i, j] = eps[i, j]
                elif eps_estimates[i, j] != 0: eps_val[i, j] = eps_estimates[i, j]
            # Use most recent ownership estimate
            for q in range(3, -1, -1):
                if ownership_estimates[i, q] != 0:
                    own_val[i] = ownership_estimates[i, q]
                    break

        # Calculate Valuations (TP, AS, BA)
        totals = eps_val.sum(axis=1)
        tp_v, _, _ = compute_TP_val(totals[0], own_val[0])
        as_v, _, _ = compute_AS_val(totals[1], own_val[1])
        ba_v, _, _ = compute_BA_val(totals[2], own_val[2])

        vals = [tp_v, as_v, ba_v]
        tickers = ['TP', 'AS', 'BA']

        # Smart Buffer: Larger uncertainty early on, tight at the end
        buffer = max(0.5, 5.0 * (1 - tick/300))

        for i, ticker in enumerate(tickers):
            bid, ask = get_bid_ask(ticker)
            if bid == -1: continue
            
            current_pos = pos_map.get(ticker, 0)
            
            # BUY Logic
            if ask < vals[i] - buffer and net_position < MAX_LONG_EXPOSURE_NET:
                s.post('http://localhost:9999/v1/orders', params={
                    'ticker': ticker, 'type': 'LIMIT', 'quantity': ORDER_LIMIT,
                    'price': ask, 'action': 'BUY'
                })
            
            # SELL Logic
            if bid > vals[i] + buffer and net_position > MAX_SHORT_EXPOSURE_NET:
                s.post('http://localhost:9999/v1/orders', params={
                    'ticker': ticker, 'type': 'LIMIT', 'quantity': ORDER_LIMIT,
                    'price': bid, 'action': 'SELL'
                })

        sleep(0.5)
        tick, status = get_tick()

if __name__ == '__main__':
    main()
